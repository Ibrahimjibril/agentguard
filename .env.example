# Copy to .env and fill in. NEVER commit .env.
# The LLM is used ONLY to draft policies from plain language. It never approves a payment.
# Everything else (Guard, vault, dashboard) works without an LLM key.

# Option 1: Google Gemini through its OpenAI-compatible endpoint (free tier)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Comma-separated: the next model is tried if one is overloaded or retired
LLM_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash

# Option 2: Anthropic
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# Option 3: any OpenAI-compatible endpoint, for example NEAR AI Cloud (https://cloud.near.ai)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://example.com/v1
# LLM_MODEL=your-model

# Optional: port of the local Guard API (default 8787)
# GUARD_PORT=8787
