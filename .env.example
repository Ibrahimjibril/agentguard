# Copy to .env and fill in. NEVER commit .env.
# LLM used ONLY to draft policies from plain language (it never approves payments).
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional: LLM_MODEL=claude-haiku-5-5
# For OpenAI-compatible endpoints instead:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://example.com/v1
# LLM_MODEL=your-model
